from collections import deque

class Solution:
    def minMoves(self, classroom, energy):

        m = len(classroom)
        n = len(classroom[0])
        total = m * n

        start = 0
        litter = {}
        count = 0

        for r in range(m):
            for c in range(n):

                if classroom[r][c] == 'S':
                    start = r * n + c

                elif classroom[r][c] == 'L':
                    litter[r * n + c] = count
                    count += 1

        if count == 0:
            return 0

        target = (1 << count) - 1

        best = [-1] * (total * (1 << count))

        start_state = start
        best[start_state] = energy

        queue = deque([start_state])

        directions = (-1, 0, 1, 0, -1)

        moves = 0

        while queue:
            for _ in range(len(queue)):
                state = queue.popleft()
                mask = state // total
                pos = state % total

                e = best[state]

                r = pos // n
                c = pos % n

                for k in range(4):
                    nr = r + directions[k]
                    nc = c + directions[k + 1]

                    if nr < 0 or nr >= m or nc < 0 or nc >= n:
                        continue

                    if classroom[nr][nc] == 'X':
                        continue

                    if e == 0:
                        continue

                    new_pos = nr * n + nc
                    new_e = e - 1
                    new_mask = mask

                    cell = classroom[nr][nc]

                    if cell == 'L':
                        new_mask |= 1 << litter[new_pos]

                    if cell == 'R':
                        new_e = energy

                    if new_mask == target:
                        return moves + 1

                    new_state = new_mask * total + new_pos

                    if new_e > best[new_state]:

                        best[new_state] = new_e
                        queue.append(new_state)

            moves += 1

        return -1
